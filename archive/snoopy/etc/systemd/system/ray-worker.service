[Unit]
# Ray worker on snoopy, in nvcr.io/nvidia/vllm:26.03.post1-py3 (same image
# as sparky's ray-head — torch/ray/python versions must match exactly for
# distributed inference to work).
#
# Connects to sparky's ray-head at 10.0.200.12:6379 over the ConnectX-7
# RoCE link. If the head is not yet up the container exits and
# Restart=on-failure retries every 10s, so the boot order between sparky
# and snoopy doesn't matter.
Description=Ray worker node (containerized)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/vllm/nccl-env.conf

ExecStartPre=-/usr/bin/docker rm -f ray-worker

# Same docker flags as ray-head (see sparky/etc/systemd/system/ray-head.service
# for explanations). The only differences are the ray sub-command (worker
# joining a head, not starting one) and --node-ip-address (snoopy's IP).
ExecStart=/usr/bin/docker run --rm --name ray-worker \
    --network=host \
    --gpus all \
    --cgroupns=host \
    --ipc=host \
    --device=/dev/infiniband \
    --ulimit memlock=-1 \
    --ulimit stack=67108864 \
    --shm-size=16g \
    --memory=120g \
    -v /opt/vllm/models:/models:ro \
    --env-file /opt/vllm/nccl-env.conf \
    -e VLLM_HOST_IP=10.0.200.13 \
    -e RAY_memory_monitor_refresh_ms=0 \
    nvcr.io/nvidia/vllm:26.04-py3 \
    ray start \
        --address=10.0.200.12:6379 \
        --node-ip-address=10.0.200.13 \
        --num-gpus=1 \
        --block

ExecStop=/usr/bin/docker stop --time=30 ray-worker

Restart=on-failure
RestartSec=10

# Memory cap: snoopy's worker actually does the TP=2 work for half the
# 235B model, so unlike sparky's ray-head this needs the full ~120GB.
MemoryMax=124G
OOMPolicy=stop

TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
