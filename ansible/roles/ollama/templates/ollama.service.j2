# {{ ansible_managed }}
# Generated from roles/ollama/templates/ollama.service.j2 — do NOT edit on the host.
# Edit the profile's serving_topology / the template and re-run the playbook.
{% set container_name = 'ollama-' ~ engine.name %}
[Unit]
Description=Ollama {{ engine.name }} (port {{ engine.port }}) — {{ engine.models | default([]) | join(', ') or 'no preloaded models' }}
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple

ExecStartPre=-/usr/bin/docker rm -f {{ container_name }}

# Single-node standalone server. OLLAMA_HOST binds all interfaces so Open WebUI on
# the other node can reach it over the ConnectX IP. CONTEXT_LENGTH is capped here
# because Ollama's vram-based default is computed from TOTAL unified memory and is
# huge — dangerous on a GPU shared with vLLM (see docs/serving-topology.md).
ExecStart=/usr/bin/docker run --rm --name {{ container_name }} \
    --network=host \
    --gpus all \
    --cgroupns=host \
    -e OLLAMA_HOST=0.0.0.0:{{ engine.port }} \
    -e OLLAMA_KEEP_ALIVE={{ engine.keep_alive | default(ollama_keep_alive) }} \
    -e OLLAMA_CONTEXT_LENGTH={{ engine.context_length | default(ollama_context_length) }} \
    -v {{ ollama_data_dir }}/{{ engine.name }}:/root/.ollama \
    {{ ollama_image }}

ExecStop=/usr/bin/docker stop --time=30 {{ container_name }}

Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
