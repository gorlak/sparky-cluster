  "panels": [
    {
      "id": 9,
      "type": "stat",
      "title": "Serving",
      "description": "The activated PROFILE \u2014 the basename of its ansible/profiles/<name>.yml, which is the identity everything else keys on: what `activate` takes, what the trend store labels a measurement with, what a scoreboard row is called. `empty` means nothing is serving, on purpose. Read from the reconciler's current-topology.json; vLLM's own metrics cannot say, because their `model_name` label is the stable alias every engine advertises so chat survives an activation.",
      "gridPos": {
        "h": 3,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sparky_active_profile",
          "legendFormat": "{{profile}}",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Suite",
      "description": "The suite currently holding the cluster (ADR-0021). While one runs, serving is whatever it is measuring \u2014 so a number on this dashboard belongs to a candidate, not to the promoted model.",
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
