{#-
  One rendered env file per allowlisted SGLang engine, per node (ADR-0030). The SGLang
  sibling of roles/vllm/templates/engine.env.j2, landing in the SAME {{ vllm_engines_dir }}
  so the reconciler reads every kind from one place. The ENGINE_* identity block is
  IDENTICAL to the vLLM one (the reconciler parses these kind-agnostically) plus
  ENGINE_KIND=sglang; only the serve-args builder speaks SGLang's flags.

  Field-to-flag, stated once — the profile schema is engine-neutral, SGLang's flags are not:
    tensor_parallel_size  -> --tp-size
    context_length        -> --context-length
    memory_fraction       -> --mem-fraction-static   (a static memory fraction either way;
                             the ADR-0028 headroom floor is re-derived for SGLang at
                             bring-up, so the NUMBER differs even though the field does not)
  Everything model-specific (the mamba/spec-decode/parser/PLE flags a given checkpoint
  needs) rides head_extra_args / worker_extra_args as recipe data — kept out of this
  generic builder exactly as the vLLM projection keeps them out of its own.
-#}
{% set rank = engine.nodes.index(inventory_hostname) %}
{% set is_api = rank == 0 %}
{% set nnodes = engine.nodes | length %}
{% set is_multinode = nnodes > 1 %}
{% set tp = engine.tensor_parallel_size | default(nnodes) %}
{% set master_addr = hostvars[engine.nodes[0]].vllm_host_ip %}
{% set serve_args = [] %}
{% if is_api %}
{#- SGLang's --served-model-name takes ONE value (server_args.py: Optional[str], no
    nargs), unlike vLLM's list — so an SGLang engine advertises the STABLE name only. That
    is the load-bearing one: chat and the static, model-agnostic Caddy upstream both target
    `sparky`, so conversations stay portable across activations. The real name is still
    recorded in ENGINE_SERVED_AS below; a bench/eval run addresses an SGLang engine by the
    stable name (there is only ever one live engine on the port, so it is unambiguous). -#}
{% set _ = serve_args.extend(['--host 0.0.0.0', '--port ' ~ engine.port,
                              '--served-model-name ' ~ stable_model_name]) %}
{% endif %}
{% set _ = serve_args.append('--tp-size ' ~ tp) %}
{% if is_multinode %}
{#- SGLang's native multi-node: every node runs launch_server with the same --tp-size and
    its own --node-rank, rendezvousing at rank 0's --dist-init-addr over the ConnectX-7
    rail (master_addr is the head's CX7 IP). No --headless: rank>0 nodes are workers by
    virtue of their rank, and only rank 0 binds the API port. -#}
{% set _ = serve_args.extend(['--nnodes ' ~ nnodes, '--node-rank ' ~ rank,
                              '--dist-init-addr ' ~ master_addr ~ ':' ~ sglang_dist_port]) %}
{% endif %}
{% set _ = serve_args.extend(['--trust-remote-code', '--context-length ' ~ engine.context_length,
                              '--mem-fraction-static ' ~ engine.memory_fraction]) %}
{% set _ = serve_args.extend(engine.head_extra_args | default([]) if is_api else engine.worker_extra_args | default([])) %}
# {{ ansible_managed }}
# Engine '{{ engine.name }}' of profile '{{ engine._profile }}', as seen on {{ inventory_hostname }}
# (rank {{ rank }} of {{ nnodes }}{{ ' — API host' if is_api else ' — worker' }}), served by SGLang.
# Generated from roles/sglang/templates/engine.env.j2 by `deploy` — do NOT edit on the
# host: `activate` never rewrites this. Edit ansible/profiles/{{ engine._profile }}.yml
# and re-deploy.

# --- identity (read by the reconciler, not by systemd) ----------------------
ENGINE_NAME={{ engine.name }}
ENGINE_KIND=sglang
ENGINE_PROFILE={{ engine._profile }}
ENGINE_NODES='{{ engine.nodes | join(' ') }}'
ENGINE_NODE_RANK={{ rank }}
ENGINE_API_NODE={{ engine.nodes[0] }}
ENGINE_API_ADDR={{ master_addr }}
ENGINE_PORT={{ engine.port }}
ENGINE_SERVED_AS={{ engine.served_as }}
ENGINE_STABLE_NAME={{ stable_model_name }}
ENGINE_TP={{ tp }}
# Rendezvous coupling, identical in purpose to the vLLM unit: a worker must restart
# whenever the head restarts (a new rank-0 process invalidates the workers' dist
# connection). The hash covers the whole engine spec + image, so any head-side change
# moves the worker's env file too and the reconciler restarts the pair together.
ENGINE_SPEC_HASH={{ [engine, engine._image] | to_json | hash('sha1') }}

# --- what systemd runs ------------------------------------------------------
ENGINE_MODEL={{ engine.model }}
SGLANG_IMAGE={{ engine._image }}
# Single-quoted as ONE value; sglang@.service references it UNBRACED so systemd splits it
# back into argv words (POSIX quote-removal). The fleet role asserts no flag carries a
# single quote or newline, so the round trip is exact.
SGLANG_SERVE_ARGS='{{ serve_args | join(' ') | replace('\\', '\\\\') | replace('"', '\\"') }}'
