# {{ ansible_managed }}
[Unit]
Description=Cluster control panel (FastAPI status + activate; low-privilege)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ADR-0018: the panel runs as the LOW-PRIVILEGE activation identity, not as
# `deploy`. That is the whole point — a web API can no longer invoke NOPASSWD root.
# Everything it can do is either read-only or goes through {{ activate_bin }}.
# Deliberately NOT in the docker group: docker group membership is root-equivalent.
User={{ activate_user }}
Group={{ activate_group }}
WorkingDirectory={{ control_panel_dir }}
# Config via env so the app hardcodes nothing.
Environment=PANEL_NODE={{ inventory_hostname }}
Environment=CLUSTER_TOPOLOGY={{ cluster_topology_file }}
Environment=CLUSTER_FLEET={{ fleet_state_file }}
Environment=CLUSTER_PROFILE={{ cluster_profile }}
Environment=ACTIVATE_BIN={{ activate_bin }}
Environment=DESIRED_PROFILE={{ desired_profile_file }}
Environment=ALLOWLIST_FILE={{ vllm_allowlist_file }}
Environment=ACTIVATE_SSH_KEY={{ activate_ssh_key }}
Environment=ACTIVATE_SSH_USER={{ activate_user }}
# Worker reachability for the read-only `status` verb of the forced command.
Environment=NODE_ADDRS={% for node in groups['all'] | sort if node != inventory_hostname %}{{ node }}={{ hostvars[node].vllm_host_ip }} {% endfor %}
# Exporter ports, so the panel can assert metrics are being PRODUCED —
# not merely that the endpoint answers (see _exporter_ok).
Environment=GPU_EXPORTER_PORT={{ nvidia_exporter_port }}
Environment=NODE_EXPORTER_PORT={{ node_exporter_port }}

Environment=WEBUI_URL=http://127.0.0.1:{{ webui_port }}/health
Environment=PROXY_URL=http://127.0.0.1:80/
Environment=MODEL_ENDPOINT={{ model_endpoint_url }}
# Past this, "unit up, API down" stops being a weight load and becomes a fault.
Environment=LOAD_TIMEOUT={{ vllm_start_timeout_sec }}
Environment=RUNS_DIR={{ control_panel_dir }}/runs
# The suite trigger (ADR-0021). The panel starts a suite as a unit of its OWN rather
# than as a child, because every deploy restarts this service and a three-hour suite
# must not die with it.
Environment=SUITE_BIN={{ suite_bin }}
Environment=SUITE_UNIT={{ suite_unit }}
Environment=SUITE_DIR={{ suite_dir }}
Environment=SUITE_LOG_DIR={{ suite_log_dir }}
ExecStart={{ control_panel_dir }}/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port {{ control_panel_port }} --root-path /admin
Restart=on-failure
RestartSec=5
# An activation is a detached child (own session) that writes its result to disk.
# KillMode=process means restarting the panel kills only uvicorn, so an in-flight
# run survives and a fresh panel reconstructs its status from $RUNS_DIR.
KillMode=process

[Install]
WantedBy=multi-user.target
