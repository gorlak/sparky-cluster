# {{ ansible_managed }}
# Generated from roles/vllm/templates/vllm.service.j2 — do NOT edit on the host.
# Edit the profile's serving_topology / the template and re-run the playbook.
{% set rank = engine.nodes.index(inventory_hostname) %}
{% set is_api = rank == 0 %}
{% set nnodes = engine.nodes | length %}
{% set is_multinode = nnodes > 1 %}
{% set tp = engine.tensor_parallel_size | default(nnodes) %}
{% set container_name = 'vllm-' ~ engine.name %}
{% set master_addr = hostvars[engine.nodes[0]].vllm_host_ip %}
[Unit]
{% if is_api %}
Description=vLLM {{ engine.name }} head (rank {{ rank }}, API on :{{ engine.port }}) — TP={{ tp }}, no Ray
{% else %}
Description=vLLM {{ engine.name }} headless worker (rank {{ rank }}) — TP={{ tp }}, no Ray
{% endif %}
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

# Fail-safe boot (ADR-0011). The marker below is touched at start and removed on
# any CLEAN stop (ExecStopPost). It therefore only survives to a subsequent boot
# after an UNCLEAN shutdown — a hang / hard-reset / power cut mid-run. When it
# survives, this condition skips auto-start so the node boots EMPTY and reachable
# rather than re-attempting the risky 121 GiB / multi-node load unattended.
# A deploy clears the marker before (re)starting, so operator-driven bring-up
# always proceeds; note a bare `systemctl start/restart` is skipped while the
# marker exists — clear it (or run a deploy) to restart outside Ansible.
ConditionPathExists=!{{ vllm_state_dir }}/{{ container_name }}.running

# Crash-loop breaker (idiomatic, complements the marker): if the unit fails more
# than 5 times in 15 min, stop retrying and stay failed+reachable instead of
# restarting forever. Does NOT cover a host hang (a wedged process is never
# counted as a failed start) — that's what the marker above is for.
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile={{ nccl_conf_path }}

ExecStartPre=-/usr/bin/docker rm -f {{ container_name }}
# Arm the fail-safe marker (see [Unit] ConditionPathExists). mkdir is defensive;
# the common role already creates {{ vllm_state_dir }}.
ExecStartPre=/usr/bin/mkdir -p {{ vllm_state_dir }}
ExecStartPre=/usr/bin/touch {{ vllm_state_dir }}/{{ container_name }}.running

{% set serve_args = [] %}
{% if is_api %}
{% set _ = serve_args.extend(['--host 0.0.0.0', '--port ' ~ engine.port, '--served-model-name ' ~ engine.served_as]) %}
{% endif %}
{% set _ = serve_args.extend(['--tensor-parallel-size ' ~ tp, '--distributed-executor-backend mp']) %}
{% if is_multinode %}
{% set _ = serve_args.extend(['--nnodes ' ~ nnodes, '--node-rank ' ~ rank, '--master-addr ' ~ master_addr]) %}
{% endif %}
{% if not is_api %}
{% set _ = serve_args.append('--headless') %}
{% endif %}
{% set _ = serve_args.extend(['--trust-remote-code', '--max-model-len ' ~ engine.max_model_len, '--gpu-memory-utilization ' ~ engine.gpu_memory_utilization]) %}
{% set _ = serve_args.extend(engine.head_extra_args | default([]) if is_api else engine.worker_extra_args | default([])) %}
ExecStart=/usr/bin/docker run --rm --name {{ container_name }} \
    --network=host \
    --gpus all \
    --cgroupns=host \
    --ipc=host \
    --device=/dev/infiniband \
    --ulimit memlock=-1 \
    --ulimit stack=67108864 \
    --shm-size={{ vllm_shm_size }} \
    --memory={{ vllm_container_memory }} \
    -v {{ vllm_models_dir }}:/models:ro \
    -v {{ nccl_conf_path }}:/etc/nccl-env.conf:ro \
    --env-file {{ nccl_conf_path }} \
    -e HF_HOME=/tmp/hf \
    -e VLLM_HOST_IP={{ vllm_host_ip }} \
    -e VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=1 \
    {{ vllm_image }} \
    vllm serve /models/{{ engine.model }} \
        {{ serve_args | join(' \\\n        ') }}

ExecStop=/usr/bin/docker stop --time=120 {{ container_name }}
# Disarm the fail-safe marker on any clean stop (deploy, teardown, clean reboot).
# Runs for a crash-exit too — so only an UNCLEAN shutdown leaves it behind.
ExecStopPost=/usr/bin/rm -f {{ vllm_state_dir }}/{{ container_name }}.running

MemoryMax={{ vllm_systemd_memory_max }}
OOMPolicy=stop

Restart=on-failure
RestartSec={{ 60 if is_api else 10 }}

TimeoutStartSec=1200
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
