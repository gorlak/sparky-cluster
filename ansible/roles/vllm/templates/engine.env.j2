{#-
  One rendered env file per allowlisted engine, per node (ADR-0018). This is the
  WHOLE per-variant surface — flat, diffable, easy to plan-and-confirm — read by
  vllm@.service (systemd EnvironmentFile) and by the reconciler (which parses it
  directly to decide what to activate).

  `engine` is the loop var: a serving_topology entry carrying the `_profile` /
  `_image` / `_blocked` provenance the fleet role attached.
-#}
{% set rank = engine.nodes.index(inventory_hostname) %}
{% set is_api = rank == 0 %}
{% set nnodes = engine.nodes | length %}
{% set is_multinode = nnodes > 1 %}
{% set tp = engine.tensor_parallel_size | default(nnodes) %}
{% set master_addr = hostvars[engine.nodes[0]].vllm_host_ip %}
{% set serve_args = [] %}
{% if is_api %}
{#- The API rank advertises BOTH the stable, model-agnostic name (chat targets it,
    so conversations stay portable across activations) and the engine's real name
    (bench/eval target that). vLLM takes several --served-model-name values; the
    first is what it reports back in responses. -#}
{% set _ = serve_args.extend(['--host 0.0.0.0', '--port ' ~ engine.port,
                              '--served-model-name ' ~ stable_model_name ~ ' ' ~ engine.served_as]) %}
{% endif %}
{% set _ = serve_args.extend(['--tensor-parallel-size ' ~ tp, '--distributed-executor-backend mp']) %}
{% if is_multinode %}
{% set _ = serve_args.extend(['--nnodes ' ~ nnodes, '--node-rank ' ~ rank, '--master-addr ' ~ master_addr]) %}
{% endif %}
{% if not is_api %}
{% set _ = serve_args.append('--headless') %}
{% endif %}
{% set _ = serve_args.extend(['--trust-remote-code', '--max-model-len ' ~ engine.context_length,
                              '--gpu-memory-utilization ' ~ engine.memory_fraction]) %}
{% set _ = serve_args.extend(engine.head_extra_args | default([]) if is_api else engine.worker_extra_args | default([])) %}
# {{ ansible_managed }}
# Engine '{{ engine.name }}' of profile '{{ engine._profile }}', as seen on {{ inventory_hostname }}
# (rank {{ rank }} of {{ nnodes }}{{ ' — API host' if is_api else ' — headless worker' }}).
# Generated from roles/vllm/templates/engine.env.j2 by `deploy` — do NOT edit on the
# host: `activate` never rewrites this, so a hand-edit survives until the next deploy
# silently reverts it. Edit ansible/profiles/{{ engine._profile }}.yml and re-deploy.

# --- identity (read by the reconciler, not by systemd) ----------------------
ENGINE_NAME={{ engine.name }}
ENGINE_KIND=vllm
ENGINE_PROFILE={{ engine._profile }}
ENGINE_NODES='{{ engine.nodes | join(' ') }}'
ENGINE_NODE_RANK={{ rank }}
ENGINE_API_NODE={{ engine.nodes[0] }}
ENGINE_API_ADDR={{ master_addr }}
ENGINE_PORT={{ engine.port }}
ENGINE_SERVED_AS={{ engine.served_as }}
ENGINE_STABLE_NAME={{ stable_model_name }}
ENGINE_TP={{ tp }}
# Rendezvous coupling (was the engine-spec-hash in the pre-ADR-0018 unit template).
# A worker MUST restart whenever the head (rank 0) restarts: the head's new
# torch.distributed TCPStore invalidates the worker's connection and the worker
# won't reconnect on its own (its heartbeat monitor logs broken-pipe but never
# exits). This hash covers the WHOLE engine spec + image, so a head-side flag change
# changes the WORKER's env file too — the reconciler sees the hash move on both
# nodes and restarts them as a matched pair.
ENGINE_SPEC_HASH={{ [engine, engine._image] | to_json | hash('sha1') }}

# --- what systemd runs ------------------------------------------------------
ENGINE_MODEL={{ engine.model }}
VLLM_IMAGE={{ engine._image }}
# Must match this node's ConnectX-7 IP: the default route goes out the 10GbE NIC,
# so without it torch.distributed advertises the wrong address and rendezvous fails.
VLLM_HOST_IP={{ vllm_host_ip }}
# Single-quoted as ONE value; vllm@.service references it UNBRACED so systemd splits
# it back into argv words. That split is POSIX-style: it performs QUOTE REMOVAL, so a
# literal `"` must arrive here as `\"` or it is eaten on the way to argv — which is
# exactly how `--speculative-config {"method":"mtp"}` once reached vLLM as
# `{method:mtp}` and failed the JSON parse. (The env-file parse itself is innocent: it
# passes `"` through untouched. It is the ExecStart expansion that unquotes.)
# Backslashes are escaped first so an existing `\` cannot forge an escape.
VLLM_SERVE_ARGS='{{ serve_args | join(' ') | replace('\\', '\\\\') | replace('"', '\\"') }}'
