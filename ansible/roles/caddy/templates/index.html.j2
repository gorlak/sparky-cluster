<!DOCTYPE html>
<!-- {{ ansible_managed }} — generated from roles/caddy/templates/index.html.j2 -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>sparky cluster</title>
  <!-- Same stylesheet the control panel and scoreboard use, installed beside this file by
       the caddy role. All four pages are one product; before 2026-08-12 this one carried
       its own copy of the panel's OLD values (42rem, no font-size) and had already drifted
       apart from it. What stays below is only what this page alone needs. -->
  <link rel="stylesheet" href="/app.css">
  <style>
    ul { list-style: none; padding: 0; }
    li { margin: .75rem 0; padding: .9rem 1.1rem; border: 1px solid var(--line);
         border-radius: .6rem; }
    li a { font-size: 1.1rem; }
    .blurb { display: block; opacity: .7; font-size: .9rem; margin-top: .2rem; }
    #failsafe-banner { display: none; margin: 0 0 1.5rem; padding: .9rem 1.1rem;
      border: 1px solid var(--bad); border-radius: .6rem; background: #c6282814; }
    #failsafe-banner strong { color: var(--bad); }
  </style>
</head>
<body>
  <h1>sparky cluster</h1>
  <p class="sub">{{ web_domain }}</p>
  <div id="failsafe-banner">
    <strong>⚠ Cluster in fail-safe recovery</strong>
    <span class="blurb">A node booted empty after an unclean shutdown (ADR-0009).
      <a href="/admin">Open the control panel</a> to recover to the deployed configuration.</span>
  </div>
  <ul>
  {% for svc in landing_services %}
    <li>
      <a href="{{ svc.url }}">{{ svc.name }}</a>
      <span class="blurb">{{ svc.blurb }}</span>
    </li>
  {% endfor %}
  </ul>
  <script>
    // Reveal the banner if the control panel reports the fail-safe recovery
    // state (ADR-0009). Caddy exposes this one read-only sliver of the panel
    // outside /admin's basic_auth (ADR-0018); fails silently.
    fetch('/cluster-health.json')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (d && d.failsafe) document.getElementById('failsafe-banner').style.display = 'block';
      })
      .catch(function () {});
  </script>
</body>
</html>
