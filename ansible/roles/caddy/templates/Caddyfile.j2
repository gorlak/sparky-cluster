# {{ ansible_managed }}
# Generated from roles/caddy/templates/Caddyfile.j2 — edit the template, not the host.
{
	# LAN-only HTTP; no public certs for these internal hostnames.
	auto_https off
	admin localhost:2019
}

# Open WebUI — its own hostname, served at root (avoids Open WebUI's subpath issues).
http://chat.{{ web_domain }} {
	reverse_proxy 127.0.0.1:{{ webui_port }}
}

# Landing page + control panel — catch-all for any other host on :80
# ({{ web_domain }}, bare IP, etc.)
:80 {
	# Control panel at /admin (prefix stripped before proxying). It's open today
	# (cluster is behind the firewall); to gate it later, uncomment basic_auth and
	# supply a hash from a gitignored var (e.g. `caddy hash-password`).
	handle_path /admin* {
		# basic_auth {
		# 	admin {{ admin_basic_auth_hash | default('REPLACE_ME') }}
		# }
		reverse_proxy 127.0.0.1:{{ control_panel_port }}
	}

	# Everything else → static landing page
	handle {
		root * /srv/landing
		file_server
	}
}
