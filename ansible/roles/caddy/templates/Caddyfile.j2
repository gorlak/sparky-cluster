# {{ ansible_managed }}
# Generated from roles/caddy/templates/Caddyfile.j2 — edit the template, not the host.
{
	# LAN-only HTTP; no public certs for these internal hostnames.
	auto_https off
	admin localhost:2019
}

# The fixed model endpoint (ADR-0018). Open WebUI and Prometheus point HERE, once,
# at deploy time — never at an engine's node.
#
# The upstream list is STATIC over every node and never rewritten: exactly one
# engine is ever alive on :{{ vllm_api_port }} fleet-wide (the reconciler
# stops-then-starts), so `lb_policy first` + active health checks make routing
# FOLLOW activation with no config rewrite, no reload, and no persisted state. On
# boot Caddy comes up static and converges the moment the restored engine passes
# health. Replicas of one model, if ever wanted, are the same mechanism — two
# healthy upstreams and Caddy balances.
http://{{ model_endpoint_host }} {
	reverse_proxy {% for node in groups['all'] | sort %}{{ hostvars[node].vllm_host_ip }}:{{ vllm_api_port }} {% endfor %}{
		lb_policy first
		health_uri /health
		health_interval 5s
		health_timeout 2s
		health_status 2xx
		fail_duration 10s
		# A cold engine can take many minutes to load weights; don't cut the request
		# that arrives while it finishes.
		transport http {
			dial_timeout 5s
			response_header_timeout 600s
		}
	}
}

# Open WebUI — its own hostname, served at root (avoids Open WebUI's subpath issues).
http://chat.{{ web_domain }} {
	reverse_proxy 127.0.0.1:{{ webui_port }}
}

# Grafana — its own hostname.
http://metrics.{{ web_domain }} {
	reverse_proxy 127.0.0.1:{{ grafana_port }}
}

# Landing page + control panel — catch-all for any other host on :80
# ({{ web_domain }}, bare IP, etc.)
:80 {
	# The one unauthenticated sliver of the panel: the landing page's fail-safe
	# banner (ADR-0009). Read-only, three booleans, no actions — worth keeping open
	# so "is the cluster in recovery?" is answerable without a login.
	handle /cluster-health.json {
		rewrite * /health.json
		reverse_proxy 127.0.0.1:{{ control_panel_port }}
	}

	# The fleet scoreboard — measurement results, open like the health sliver above.
	#
	# It lived under /admin only because that is where the panel is mounted, which put
	# read-only benchmark data behind the ACTIVATION gate. Those are different things:
	# basic_auth on /admin exists because the panel can change what is serving (ADR-0018),
	# and nothing here can. This route is a single exact path — NOT a prefix — so opening
	# it exposes one GET that renders a JSON file, rather than the panel's whole surface.
	#
	# Deliberately no auth: a scoreboard you have to log in to read is a scoreboard nobody
	# reads, and every number on it is an aggregate about models we chose to run.
	handle /scoreboard {
		reverse_proxy 127.0.0.1:{{ control_panel_port }}
	}

	# Control panel at /admin (prefix stripped before proxying). ADR-0008 built this
	# auth seam and deferred it while the panel was human-only behind the firewall;
	# ADR-0018 turns it ON — the panel is now deliberately agent-drivable and holds
	# the activation grant, so it can't stay open. The hash is a runtime secret
	# ({{ caddy_admin_hash_file }}), never in git: `./sparky.sh admin-password`.
	handle_path /admin* {
		basic_auth {
			{{ admin_basic_auth_user }} {{ admin_basic_auth_hash }}
		}
		reverse_proxy 127.0.0.1:{{ control_panel_port }}
	}

	# Everything else → static landing page
	handle {
		root * /srv/landing
		file_server
	}
}
