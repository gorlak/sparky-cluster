# {{ ansible_managed }}
# One STATIC vLLM scrape target: the fixed model endpoint (ADR-0018). Prometheus is
# configured once at deploy time and never re-pointed by an activation — Caddy's
# health-checked upstream list already routes to whichever node is serving, so the
# scrape follows the live engine for free.
#
# The series stay separable because vLLM's metrics carry a `model_name` label, which
# is what the Grafana dashboard groups by; a switch shows up as one series ending and
# another beginning. `up` goes to 0 for the window where nothing is activated — that
# is the honest reading of "the fleet is serving nothing", not a fault.
- targets: ["{{ model_endpoint_host }}:80"]
  labels:
    endpoint: "{{ stable_model_name }}"
