# {{ ansible_managed }}
# Infra targets (node/gpu) come from the inventory (ConnectX IPs); vLLM targets
# come from the profile's serving_topology via file_sd (vllm_targets.yml), so
# switching profiles reloads targets WITHOUT a Prometheus restart.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: vllm
    # One target per vLLM engine's API endpoint — generated from serving_topology
    # into vllm_targets.yml (see vllm_targets.yml.j2). file_sd hot-reloads it.
    file_sd_configs:
      - files:
          - /etc/prometheus/vllm_targets.yml

  # `instance` is relabelled to the HOSTNAME. Targets must be addressed by ConnectX IP
  # (that is the interface carrying cluster traffic), but an IP is meaningless on a
  # dashboard — "10.0.200.13 is at 50% CPU" makes you look up which box that is, every
  # time. Relabelling here rather than editing each panel's legendFormat means every
  # query gets hostnames, including ones written later, and `instance` stays the single
  # identifier for a node across all jobs.
  - job_name: node
    static_configs:
{% for h in groups['all'] %}
      - targets: ['{{ hostvars[h].vllm_host_ip }}:{{ node_exporter_port }}']
        labels:
          node: '{{ h }}'
{% endfor %}
    relabel_configs:
      - source_labels: [node]
        target_label: instance

  # What is ACTIVATED, and whether a runbook is driving the cluster. Neither is
  # discoverable from an exporter: vLLM's `model_name` label is the stable alias every
  # engine advertises (`{{ stable_model_name }}`), deliberately
  # model-agnostic so chat survives an activation — and a runbook is not an engine at all.
  # The control panel already knows both, so it exports them rather than a sidecar
  # existing to read two files. Loopback: this container is `network_mode: host`, and the
  # panel binds 127.0.0.1, so the scrape never crosses Caddy or its basic_auth.
  - job_name: cluster
    static_configs:
      - targets: ['127.0.0.1:{{ control_panel_port }}']
        labels:
          node: '{{ inventory_hostname }}'
    relabel_configs:
      - source_labels: [node]
        target_label: instance

  - job_name: gpu
    static_configs:
{% for h in groups['all'] %}
      - targets: ['{{ hostvars[h].vllm_host_ip }}:{{ nvidia_exporter_port }}']
        labels:
          node: '{{ h }}'
{% endfor %}
    relabel_configs:
      - source_labels: [node]
        target_label: instance
