# {{ ansible_managed }}
[Unit]
Description=Check whether the fleet has gone quiet (scale to zero)

[Timer]
# THREE anchors, and the first one is load-bearing.
#
# `OnBootSec` is relative to BOOT and `OnUnitActiveSec` to the service's last run, so a
# timer restarted mid-uptime (i.e. by every deploy) has neither: boot elapsed hours ago
# and, with Persistent=false, a missed trigger is skipped rather than caught up; and the
# service has not run since the restart, so there is nothing to count from. systemd then
# schedules NOTHING — `systemctl list-timers` shows NEXT and LEFT as "-".
#
# Observed 2026-08-13: the deploy at 01:59:53 stopped scale-to-zero silently. A dead
# dead-man's switch that announces nothing is the worst failure this file can have, which
# is why `OnActiveSec` (relative to the TIMER starting) is here — it always has an anchor.
OnActiveSec={{ idle_check_seconds }}s
OnBootSec={{ idle_check_seconds }}s
OnUnitActiveSec={{ idle_check_seconds }}s
# LOAD-BEARING. systemd's default AccuracySec is 1 MINUTE — it batches timer wake-ups to
# save power — so every value above is a fiction without this: the file would say 5 s and
# the timer would fire whenever it liked within the minute. It applies to OnActiveSec and
# OnBootSec too, so the FIRST tick after a deploy is affected as much as the steady state.
AccuracySec={{ idle_check_accuracy }}
# Jitter is added directly to how long a held caller waits to be noticed, and there is
# only one timer on this box to spread. Keep it at 0.
RandomizedDelaySec={{ idle_check_jitter }}
Persistent=false

[Install]
WantedBy=timers.target
