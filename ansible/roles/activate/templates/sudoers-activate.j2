# {{ ansible_managed }}
# The LOCAL bounded trigger (ADR-0018). Unlike a scoped-`systemctl` grant — which
# is still a family of general-purpose commands, i.e. a shell-shaped hole reachable
# from a web API — the only invocable thing here is ONE fixed, input-validating
# program that can do nothing but activate a deployed, allowlisted profile.
#
# Members of `{{ activate_group }}` are the activation identity: the control-panel
# service ({{ activate_user }}) and geoff. `deploy`'s NOPASSWD: ALL is NOT reachable
# from any service — it is enterable only through geoff's password.
%{{ activate_group }} ALL=(root) NOPASSWD: {{ activate_bin }}

# The READ-ONLY grant (ADR-0019). `vllm-probe` answers questions about an image that
# is ALREADY deployed — what vLLM/NCCL it ships, which architectures and quantization
# methods it supports — and can do nothing else: the image must be in the root-owned
# allowlist, the probe is a key into a fixed dict of programs, arguments must be bare
# identifiers, and the docker flags are constants with no mounts, no devices and no
# network. It exists so evaluating a model does not require handing out `sudo docker`,
# which would be handing out root.
%{{ activate_group }} ALL=(root) NOPASSWD: {{ probe_bin }}

{% if inventory_hostname in groups['head'] %}
# The DETACHED-RUN grant (ADR-0021), and the only one here that is not about privilege.
# A runbook run needs nothing root — it activates (already granted above) and then talks
# HTTP. What it needs is to outlive its caller: a process the control panel spawns dies
# with the panel's cgroup, and every deploy restarts the panel, so a three-hour campaign
# would be killed by routine maintenance. `vllm-runbook` starts it as a transient unit
# instead, and can do nothing else: the runbook must be in the deploy-written allowlist,
# the argument is a bare identifier, and every path — log, unit, harness — is composed
# by the program from constants.
%{{ activate_group }} ALL=(root) NOPASSWD: {{ runbook_bin }}
{% endif %}

# The cross-node trigger arrives as forced-command SSH; sshd puts the request in
# SSH_ORIGINAL_COMMAND, and sudo's env_reset would otherwise drop it. The value
# never reaches a shell (the forced command is a fixed string) and the reconciler
# validates it against a four-token grammar before acting.
Defaults:{{ activate_user }} env_keep += "SSH_ORIGINAL_COMMAND"
