#!/usr/bin/env python3
"""Give a suite run a detached, logged home (ADR-0021).

The third bounded trigger, after `vllm-activate` (ADR-0018) and `vllm-probe` (ADR-0019),
and the only one that exists for a reason other than privilege.

**Nothing in a suite needs root.** It activates — already granted to `activator` through
the reconciler — then drives the endpoint over HTTP. What it needs is to **outlive
whatever started it**: a process the control panel spawns is a child in
`control-panel.service`'s cgroup, and every deploy restarts that service, so a three-hour
suite would die at the ninety-minute mark. `setsid` does not help; a new session is the
same cgroup. Only a unit of its own survives, and starting a system unit is privileged.

Detached and logged both fall out of that one mechanism: the unit has its own lifetime, and
`StandardOutput=append:` gives it a log with no wrapper, no pipe and no pid file.

Bounded exactly like its siblings:

  * the suite must be in the deploy-written allowlist. `sparky run` reads the repo,
    because it runs on the control node and a suite you are editing should work at once;
    a NETWORK-facing caller must not be able to instance a file that merely happens to be
    in a git checkout
  * the argument is a bare identifier. Every path — log, unit, harness — is composed here
    from constants, so nothing from an HTTP request is ever a path or reaches a shell
  * the unit is fixed, so one run holds the cluster at a time — visible in `systemctl`,
    not only in the suite's own lock file
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

# Deploy-written, root-owned. The repo copy is what `sparky run` reads; this is what a
# network caller may name. The two diverge deliberately — see ADR-0021.
SUITE_DIR = Path("/opt/cluster/suites")
# The published harness, installed into a venv by `deploy`. Published source alone is not
# runnable: there is no interpreter on the box that can resolve its dependencies.
HARNESS = Path("/opt/cluster/harness/bin/sparky")
LOG_DIR = Path("/opt/cluster/suite-logs")
UNIT = "sparky-suite.service"
RUN_USER = "activator"
RUN_GROUP = "activate"
NAME_RE = re.compile(r"\A[a-z0-9][a-z0-9._-]{0,63}\Z")


def die(msg: str, code: int = 2):
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def usage():
    die(f"usage: {Path(sys.argv[0]).name} start <suite> | stop | status")


def available(directory: Path = SUITE_DIR) -> list[str]:
    try:
        return sorted(p.stem for p in directory.glob("*.yml"))
    except OSError:
        return []


def validate(argv: list[str], *, directory: Path = SUITE_DIR) -> tuple[str, str | None]:
    """The whole decision, pure — so the tests exercise it with no systemd and no deploy.

    Returns `(verb, name)`; raises SystemExit on anything it will not run, which is how a
    bad request becomes a refusal rather than a shell.
    """
    if not argv:
        usage()
    verb, rest = argv[0], argv[1:]

    if verb in ("stop", "status"):
        if rest:
            die(f"'{verb}' takes no arguments")
        return verb, None
    if verb != "start":
        die(f"unknown verb {verb!r} — expected start, stop or status")
    if len(rest) != 1:
        usage()

    name = rest[0]
    # A bare identifier, not a path. The allowlist would be decoration if a caller could
    # name `../../etc/anything`, and checking the shape first makes traversal
    # unexpressible rather than merely filtered.
    if not NAME_RE.match(name):
        die(f"{name!r} is not a suite name (lowercase, digits, dot, dash, underscore)")

    allowed = available(directory)
    if not allowed:
        die(f"no suites installed at {directory}. A suite reaches this trigger by "
            f"deploy — `sparky run` reads the repo, which is not the same list (ADR-0021).")
    if name not in allowed:
        die(f"{name!r} is not an installed suite.\n  installed: {', '.join(allowed)}\n"
            f"  Adding one is a deploy.")
    return verb, name


def _active() -> bool:
    return subprocess.run(["systemctl", "is-active", "--quiet", UNIT]).returncode == 0


def main(argv: list[str]) -> int:
    verb, name = validate(argv)

    if verb == "status":
        return subprocess.run(["systemctl", "status", "--no-pager", UNIT]).returncode
    if verb == "stop":
        # Safe by construction: breadcrumbs are written after every regiment (ADR-0016),
        # so a stopped run resumes rather than restarts.
        return subprocess.run(["systemctl", "stop", UNIT]).returncode

    if _active():
        die("a suite is already running — stop it first", 3)
    if not HARNESS.exists():
        die(f"no harness at {HARNESS} — run ./sparky.sh deploy")

    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log = LOG_DIR / f"{name}.log"
    # Appended, never truncated: a suite RESUMES, so its runs are episodes of one
    # suite and reading them together is the point.
    #
    # No `--collect`: a collected unit takes its exit status with it, and "did last
    # night's run finish clean?" is the question this exists to answer. `reset-failed`
    # clears the previous corpse instead.
    subprocess.run(["systemctl", "reset-failed", UNIT],
                   stderr=subprocess.DEVNULL, check=False)
    return subprocess.run([
        "systemd-run",
        f"--unit={UNIT.removesuffix('.service')}",
        f"--description=sparky suite: {name}",
        f"--uid={RUN_USER}", f"--gid={RUN_GROUP}",
        f"--property=StandardOutput=append:{log}",
        f"--property=StandardError=append:{log}",
        # 0002, so what the run records stays writable by the `activate` group — the
        # operator reads and rewrites the same trend store from the CLI.
        "--property=UMask=0002",
        "--property=KillMode=mixed",
        "--property=TimeoutStopSec=180",
        f"--setenv=HOME=/home/{RUN_USER}",
        "--setenv=TERM=dumb",          # rich renders 80-col plain text into the log
        "--",
        # `suite` is the FOREGROUND runner; `run` is the launcher that got us here. The
        # unit must execute the former or it would trigger itself. The path is composed
        # from constants — the caller never supplies one.
        str(HARNESS), "suite", str(SUITE_DIR / f"{name}.yml"),
    ]).returncode


if __name__ == "__main__":
    if os.geteuid() != 0:
        die("must run as root (through the single-command sudoers entry)")
    raise SystemExit(main(sys.argv[1:]))
