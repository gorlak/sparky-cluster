def parse_ssh_request(original: str) -> list[str]:
    """Validate SSH_ORIGINAL_COMMAND against the one grammar this channel accepts.
    The value never reaches a shell — the forced command is a fixed string and this
    is an env var — so validation is about refusing nonsense, not escaping it."""
    tokens = original.split()
    if not tokens or len(tokens) > 4 or not all(TOKEN_RE.match(t) for t in tokens):
        raise ActivateError(f"malformed request: {original!r}")
    if tokens[0] == "status":
        if len(tokens) != 1:
            raise ActivateError(f"malformed request: {original!r}")
        return tokens
    if tokens[0] not in PHASES or len(tokens) < 2:
        raise ActivateError(f"malformed request: {original!r}")
    if any(t not in ("force", "preserve") for t in tokens[2:]):
        raise ActivateError(f"malformed request: {original!r}")
    return tokens


def main(argv: list[str]) -> int:
    original = os.environ.get("SSH_ORIGINAL_COMMAND")
    if original is not None and not argv:
        # Arrived over the forced-command channel: the request is the env var.
        try:
            tokens = parse_ssh_request(original)
        except ActivateError as exc:
            print(str(exc), file=sys.stderr)
            return 2
        if tokens[0] == "status":
            print(json.dumps(node_status()))
            return 0
        phase, profile = tokens[0], tokens[1]
        argv = ["--node", profile, "--phase", phase] + [f"--{t}" for t in tokens[2:]]

    force = "--force" in argv
    preserve = "--preserve" in argv
    if "--status" in argv:
        print(json.dumps(node_status(), indent=2))
        return 0

    if os.geteuid() != 0:
        print(f"{sys.argv[0]} must run as root — it is reached through the "
              f"single-command sudoers entry or forced-command SSH.", file=sys.stderr)
        return 2

    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCK_FILE, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("another activation is in flight — refusing to interleave.", file=sys.stderr)
            return 2

        if "--node" in argv:
            # A missing value is uncertainty, and uncertainty means `empty` — never a
            # guess at which model the caller meant.
            i = argv.index("--node")
            profile = argv[i + 1] if len(argv) > i + 1 else EMPTY
            phase = "all"
            if "--phase" in argv:
                j = argv.index("--phase")
                phase = argv[j + 1] if len(argv) > j + 1 else "?"
            if phase not in PHASES:
                print(f"unknown phase {phase!r}", file=sys.stderr)
                return 2
            try:
                reconcile_node(profile, phase=phase, force=force, preserve=preserve)
            except ActivateError as exc:
                print(str(exc), file=sys.stderr)
                return 1
            return 0

        positional = [a for a in argv if not a.startswith("-")]
        profile = positional[0] if positional else read_request()
        return run_fleet(profile, force=force, preserve=preserve)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
