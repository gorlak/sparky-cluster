# Ansible runtime artifacts
*.retry
.ansible/

# Python caches
__pycache__/
*.py[cod]

# uv / venv / pytest (the `sparky` harness — ADR-0010). uv.lock IS tracked.
.venv/
.pytest_cache/
*.egg-info/

# Benchmark run outputs (regenerable; the dir is kept via .gitkeep)
benchmark/results/*.json

# Claude Code local state (settings.local.json, etc.) — kept out of the repo.
# CLAUDE.md itself IS tracked (a thin entry point that imports README.md).
.claude/
